<!doctype html>
<html lang="lt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b141c">
<title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap">
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'shop.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
{%- if template.name == 'index' -%}
<div class="intro" aria-hidden="true">
  <div class="intro-word">{% assign letters = 'V,I,K,T,O,R,M,A' | split: ',' %}{% for l in letters %}<span style="--i:{{ forloop.index0 }}">{{ l }}</span>{% endfor %}</div>
  <div class="intro-bar"></div>
</div>
<script>try{if(sessionStorage.getItem('vk_intro')){document.querySelector('.intro').remove()}else{sessionStorage.setItem('vk_intro','1')}}catch(e){}</script>
{%- endif -%}
<a class="skip" href="#main">Pereiti prie turinio</a>
{% section 'header' %}
<main id="main">{{ content_for_layout }}</main>
{% section 'footer' %}
<script src="{{ 'motion.js' | asset_url }}" defer></script>
<script src="{{ 'shop.js' | asset_url }}" defer></script>
</body>
</html>
