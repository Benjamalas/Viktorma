<section class="shop-page">
  <div class="wrap">
    <div class="page-head reveal"><p class="eyebrow">Krepšelis</p><h1 class="display">Jūsų užsakymas</h1></div>
    {%- if cart.item_count == 0 -%}
      <div class="empty center"><p class="muted">Krepšelis tuščias.</p><a class="btn btn-gold" href="{{ routes.all_products_collection_url }}">Pasirinkti dalis</a></div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart">
        <ul class="lines">
          {%- for item in cart.items -%}
            <li class="line">
              <a class="line-img" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{%- else -%}<span class="ph"></span>{%- endif -%}</a>
              <div class="line-info">
                <a href="{{ item.url }}"><h3>{{ item.product.title }}</h3></a>
                {%- unless item.product.has_only_default_variant %}<span class="muted">{{ item.variant.title }}</span>{% endunless -%}
                <div class="line-row">
                  <input class="qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Kiekis">
                  <a class="remove" href="{{ item.url_to_remove }}">Šalinti</a>
                  <b class="line-total">{{ item.final_line_price | money }}</b>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="summary">
          <div class="sum-row"><span>Tarpinė suma</span><b>{{ cart.total_price | money }}</b></div>
          <p class="muted small">Pristatymas ir mokesčiai skaičiuojami atsiskaitant.</p>
          <textarea name="note" placeholder="Pastaba užsakymui (pvz. automobilio markė, metai, VIN)" rows="2">{{ cart.note }}</textarea>
          <div class="sum-btns">
            <button class="btn btn-ghost" type="submit" name="update">Atnaujinti</button>
            <button class="btn btn-gold" type="submit" name="checkout">Apmokėti</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Krepšelis" }
{% endschema %}
