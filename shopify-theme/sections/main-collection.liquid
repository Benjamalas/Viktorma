{%- paginate collection.products by 24 -%}
<section class="shop-page">
  <div class="wrap">
    <div class="page-head reveal">
      <p class="eyebrow">Dalys</p>
      <h1 class="display">{{ collection.title }}</h1>
      <p class="muted count">{{ collection.products_count }} {% if collection.products_count == 1 %}prekė{% else %}prekių{% endif %}</p>
    </div>
    <div class="toolbar">
      <button class="btn btn-ghost filter-open" data-toggle="filters">{% render 'icon', name: 'filter' %} Filtrai{% assign n = 0 %}{% for f in collection.filters %}{% assign n = n | plus: f.active_values.size %}{% endfor %}{% if n > 0 %} · {{ n }}{% endif %}</button>
      <select id="sort-select" aria-label="Rikiuoti">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for o in collection.sort_options -%}<option value="{{ o.value }}"{% if o.value == sort_by %} selected{% endif %}>{{ o.name }}</option>{%- endfor -%}
      </select>
    </div>
    <div class="shop-layout">
      <aside class="filters-wrap">{% render 'filters', results: collection, action: collection.url, sort_by: collection.sort_by %}</aside>
      <div>
        {%- if collection.products.size == 0 -%}
          <p class="empty muted">Pagal pasirinktus filtrus dalių nerasta. <a href="{{ collection.url }}">Išvalyti filtrus</a></p>
        {%- else -%}
          <div class="grid">{%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}</div>
        {%- endif -%}
        {%- if paginate.pages > 1 %}<div class="pager">{{ paginate | default_pagination }}</div>{% endif -%}
      </div>
    </div>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Kolekcija" }
{% endschema %}
