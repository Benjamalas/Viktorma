<section class="shop-hero">
  <div class="wrap">
    <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
    <h1 class="display reveal" data-delay="1">{{ section.settings.heading }}</h1>
    <p class="lead muted reveal" data-delay="2">{{ section.settings.text }}</p>
    <div class="hero-cta reveal" data-delay="3">
      <a class="btn btn-gold" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
  <div class="hero-img reveal" data-delay="2">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600, 900, 1200', sizes: '(min-width: 900px) 640px, 92vw', alt: '' }}
    {%- else -%}
      <img src="{{ 'gearbox-600.webp' | asset_url }}" width="600" height="450" alt="" loading="eager">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Viršus",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Smulkus tekstas", "default": "Dalys · Viktorma" },
    { "type": "text", "id": "heading", "label": "Antraštė", "default": "Dalys pavarų dėžėms" },
    { "type": "textarea", "id": "text", "label": "Tekstas", "default": "Raskite reikiamą detalę pagal gamintoją, modelį ir metus." },
    { "type": "text", "id": "button_label", "label": "Mygtukas", "default": "Visos dalys" },
    { "type": "url", "id": "button_url", "label": "Mygtuko nuoroda" },
    { "type": "image_picker", "id": "image", "label": "Paveikslėlis" }
  ],
  "presets": [{ "name": "Viršus" }]
}
{% endschema %}
